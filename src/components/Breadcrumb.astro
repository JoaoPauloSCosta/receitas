---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  tone?: 'light' | 'dark';
}

const { items, tone = 'light' } = Astro.props;
const linkClass =
  tone === 'dark'
    ? 'text-white/85 hover:text-white underline-offset-4 hover:underline'
    : 'text-[#6B7280] hover:text-[#B03D1F] underline-offset-4 hover:underline';
const currentClass =
  tone === 'dark' ? 'text-white font-semibold' : 'text-[#1F1F1F] font-semibold';
const sepClass = tone === 'dark' ? 'text-white/60' : 'text-[#9CA3AF]';
---

<nav aria-label="Breadcrumb" class="py-3 text-sm leading-5">
  <ol class="flex flex-wrap items-center gap-1.5 list-none m-0 p-0">
    {items.map((item, idx) => {
      const isLast = idx === items.length - 1;
      return (
        <li class="inline-flex items-center gap-1.5 min-w-0">
          {idx > 0 && (
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class:list={['shrink-0', sepClass]}
            >
              <path
                d="M9 18l6-6-6-6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
          {item.href && !isLast ? (
            <a href={item.href} class:list={['transition-colors', linkClass]}>
              {item.label}
            </a>
          ) : (
            <span
              class:list={['truncate max-w-[260px] sm:max-w-none', currentClass]}
              aria-current={isLast ? 'page' : undefined}
            >
              {item.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
