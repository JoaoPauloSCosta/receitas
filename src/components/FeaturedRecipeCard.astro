---
import type { NormalizedRecipe } from '../lib/recipes';
import FavoriteButton from './FavoriteButton.astro';

interface Props {
  recipe: NormalizedRecipe;
  className?: string;
}

const { recipe, className = '' } = Astro.props;
const metaText = recipe.metaItems.join(' • ');
---

<article
  class:list={[
    'featured-card relative rounded-lg overflow-hidden bg-[#1F1F1F] group min-h-[352px] lg:min-h-[389px]',
    className,
  ]}
>
  <a
    href={`/receita/${recipe.id}`}
    class="block w-full h-full relative aspect-[16/9] min-h-[352px] lg:min-h-[389px] no-underline"
  >
    <img
      src={recipe.imagem}
      alt={recipe.imagemAlt}
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
      loading="lazy"
    />

    <div
      class="recipe-content absolute inset-0 flex flex-col justify-end p-4 sm:p-6 z-[2]"
      style="background: var(--mr-overlay-card);"
    >
      <div class="flex flex-wrap items-center gap-2 mb-2.5">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-white text-[#B03D1F] text-xs leading-4 font-bold uppercase tracking-[0.025em] shadow-sm">
          {recipe.categoria.label}
        </span>
      </div>

      <h3 class="mr-card-featured__title line-clamp-3 m-0">
        {recipe.titulo}
      </h3>

      {metaText && (
        <div class="mt-3 pt-3 border-t border-white/25 text-xs leading-4 font-bold text-white/95">
          {metaText}
        </div>
      )}
    </div>
  </a>

  <FavoriteButton
    recipe={recipe}
    className="absolute top-3 right-3 z-[10]"
  />
</article>
