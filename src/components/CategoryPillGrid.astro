---
import type { CategoryInfo } from '../lib/categories';

interface Props {
  categories: Array<CategoryInfo & { count?: number }>;
}

const { categories } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-7">
  {categories.map((cat) => (
    <a
      href={`/categoria/${cat.slug}`}
      class="group block relative no-underline pb-4"
    >
      <div class="aspect-[5/1] min-h-[68px] w-full rounded-2xl overflow-hidden bg-[#F3F4F6] relative shadow-sm">
        <img
          src={cat.bannerImage}
          alt=""
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
          loading="lazy"
        />
        <div
          class="absolute inset-0 bg-black/25 group-hover:bg-black/15 transition-colors"
          aria-hidden="true"
        />
      </div>

      <div
        class="-mt-4 relative z-[2] w-4/5 mx-auto rounded-full py-2 px-4 text-center shadow-md transition-transform duration-200 group-hover:-translate-y-0.5"
        style={`background-color: var(${cat.cssVarAA})`}
      >
        <span class="mr-category-pill__label block truncate">
          {cat.label}
        </span>
      </div>
    </a>
  ))}
</div>
