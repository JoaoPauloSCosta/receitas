---
import type { NormalizedRecipe } from '../lib/recipes';

interface Props {
  recipes: NormalizedRecipe[];
}

const { recipes } = Astro.props;
const slides = recipes.slice(0, 3);
---

{slides.length > 0 && (
  <section
    class="hero-swiper relative w-full h-[500px] lg:h-[700px] overflow-hidden bg-[#1F1F1F] mr-surface-dark"
    aria-roledescription="carousel"
    aria-label="Receitas em destaque"
    data-hero-carousel
  >
    {slides.map((recipe, index) => {
      const metaText = recipe.metaItems.join(' • ');
      const isActive = index === 0;
      return (
        <article
          data-hero-slide={index}
          aria-hidden={isActive ? 'false' : 'true'}
          class:list={[
            'absolute inset-0 transition-opacity duration-700',
            isActive ? 'opacity-100 z-[2] pointer-events-auto' : 'opacity-0 z-[1] pointer-events-none',
          ]}
        >
          <img
            src={recipe.imagem}
            alt={recipe.imagemAlt}
            class="w-full h-full object-cover"
            loading={index === 0 ? 'eager' : 'lazy'}
          />

          <div
            class="absolute inset-0 z-[3]"
            style="background: var(--mr-overlay-hero);"
            aria-hidden="true"
          />

          <div class="relative z-[20] max-w-[1152px] mx-auto px-4 sm:px-6 h-full flex flex-col justify-end pb-24 lg:pb-28">
            <div class="max-w-[640px]">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-white text-[#B03D1F] text-xs leading-4 font-bold uppercase tracking-[0.025em] shadow-lg">
                  RECEITA EM DESTAQUE
                </span>
                <span
                  class="inline-flex items-center px-3 py-1 rounded-full text-white text-xs leading-4 font-bold uppercase tracking-[0.025em]"
                  style={`background-color: var(${recipe.categoria.cssVarAA})`}
                >
                  {recipe.categoria.label}
                </span>
              </div>

              <h2 class="text-[24px] leading-[30px] lg:text-[30px] lg:leading-[36px] font-semibold text-white m-0">
                {recipe.titulo}
              </h2>

              <p class="mt-3 text-base lg:text-lg leading-6 lg:leading-7 text-white/90 line-clamp-2">
                {recipe.resumo}
              </p>

              <div class="mt-5 flex flex-wrap items-center gap-4">
                <a
                  href={`/receita/${recipe.id}`}
                  class="mr-btn-pill"
                >
                  Ver receita
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>

                {metaText && (
                  <span class="text-sm font-semibold text-white/90">
                    {metaText}
                  </span>
                )}
              </div>
            </div>
          </div>
        </article>
      );
    })}

    <!-- Paginação inferior 3 colunas -->
    {slides.length > 1 && (
      <div class="absolute bottom-5 inset-x-0 z-[20]">
        <div class="max-w-[1152px] mx-auto px-4 sm:px-6">
          <div class="grid grid-cols-3 gap-3 sm:gap-5 max-w-[540px]" role="tablist" aria-label="Selecionar destaque">
            {slides.map((slide, index) => (
              <button
                type="button"
                role="tab"
                data-hero-dot={index}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-label={`Ir para destaque ${index + 1}: ${slide.titulo}`}
                class="group text-left py-2 cursor-pointer bg-transparent border-0"
              >
                <span class="block text-[11px] sm:text-xs font-semibold text-white/90 truncate mb-1.5 group-hover:text-white">
                  {slide.titulo}
                </span>
                <span class="block h-1.5 w-full rounded-full bg-white/30 overflow-hidden">
                  <span
                    data-hero-progress={index}
                    class:list={[
                      'block h-full rounded-full transition-all duration-300',
                      index === 0 ? 'w-full' : 'w-0',
                    ]}
                    style="background: var(--mr-gradient-hero-progress);"
                  />
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
    )}
  </section>
)}

<script>
  const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const bars = Array.from(carousel.querySelectorAll<HTMLElement>('[data-hero-progress]'));

    if (slides.length > 1) {
      let current = 0;
      let timer: number | undefined;

      const setSlide = (idx: number) => {
        current = (idx + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.classList.toggle('opacity-100', active);
          slide.classList.toggle('z-[2]', active);
          slide.classList.toggle('pointer-events-auto', active);
          slide.classList.toggle('opacity-0', !active);
          slide.classList.toggle('z-[1]', !active);
          slide.classList.toggle('pointer-events-none', !active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });

        dots.forEach((dot, i) => {
          dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
        });

        bars.forEach((bar, i) => {
          bar.classList.toggle('w-full', i === current);
          bar.classList.toggle('w-0', i !== current);
        });
      };

      const startAuto = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        stopAuto();
        timer = window.setInterval(() => setSlide(current + 1), 6000);
      };

      const stopAuto = () => {
        if (timer !== undefined) {
          window.clearInterval(timer);
          timer = undefined;
        }
      };

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          setSlide(idx);
          startAuto();
        });
      });

      carousel.addEventListener('mouseenter', stopAuto);
      carousel.addEventListener('mouseleave', startAuto);
      carousel.addEventListener('focusin', stopAuto);
      carousel.addEventListener('focusout', startAuto);

      startAuto();
    }
  }
</script>
