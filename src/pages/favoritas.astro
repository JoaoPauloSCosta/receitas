---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import EmptyState from '../components/EmptyState.astro';
---

<BaseLayout
  title="Receitas Favoritas | Minha Receita"
  description="Suas receitas favoritas salvas localmente no navegador."
>
  <div class="max-w-[1024px] mx-auto px-4 sm:px-6 pt-4">
    <Breadcrumb
      items={[
        { label: 'Início', href: '/' },
        { label: 'Receitas Favoritas' },
      ]}
    />

    <header class="mt-2 mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="mr-display-h1 m-0">Minhas Receitas Favoritas</h1>
        <p class="text-sm sm:text-base text-[#666666] mt-2 mb-0" id="mr-fav-subtitle">
          Carregando suas receitas salvas...
        </p>
      </div>

      <button
        id="mr-clear-all-favs"
        type="button"
        class="hidden mr-btn-pill mr-btn-pill--outline"
      >
        Limpar favoritas
      </button>
    </header>

    <!-- Skeletons Shimmer (DESIGN SYSTEM §7.6.D) -->
    <div id="mr-fav-skeletons" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" aria-hidden="true">
      {[1, 2, 3].map(() => (
        <div class="flex flex-col">
          <div class="mr-skeleton w-full aspect-[3/2] rounded-lg"></div>
          <div class="mr-skeleton w-20 h-3 rounded mt-4"></div>
          <div class="mr-skeleton w-full h-[18px] rounded mt-2"></div>
          <div class="mr-skeleton w-3/4 h-[18px] rounded mt-2"></div>
          <div class="border-t border-[#F3F4F6] mt-4 pt-3">
            <div class="mr-skeleton w-28 h-3 rounded"></div>
          </div>
        </div>
      ))}
    </div>

    <div id="mr-fav-grid" class="hidden receitas-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

    <div id="mr-fav-empty" class="hidden">
      <EmptyState
        title="Você ainda não favoritou nenhuma receita"
        description="Toque no ícone de coração nos cards de receitas para montar seu livro pessoal de receitas favoritas."
        ctaLabel="Explorar receitas"
        ctaHref="/receitas"
      />
    </div>
  </div>
</BaseLayout>

<script>
  import { getFavoriteIds, syncFavoriteUI } from '../scripts/favorites';
  import { loadSearchRecipes, type SearchRecipeItem } from '../scripts/search';
  import { showToast } from '../scripts/toast';

  const skeletonWrap = document.getElementById('mr-fav-skeletons');
  const gridWrap = document.getElementById('mr-fav-grid');
  const emptyWrap = document.getElementById('mr-fav-empty');
  const subtitle = document.getElementById('mr-fav-subtitle');
  const clearAllBtn = document.getElementById('mr-clear-all-favs');

  const escapeHtml = (str: string) =>
    str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

  const renderCard = (recipe: SearchRecipeItem) => {
    const meta = [recipe.porcoes, recipe.tempoPreparo].filter(Boolean).join(' • ');
    return `
      <article class="small-card receita-item flex flex-col rounded-lg bg-white group">
        <div class="relative rounded-lg overflow-hidden aspect-[3/2] bg-[#F3F4F6]">
          <a href="${escapeHtml(recipe.url)}" class="block w-full h-full">
            <img src="${escapeHtml(recipe.imagem)}" alt="${escapeHtml(recipe.titulo)}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110" loading="lazy" />
          </a>
          <button
            type="button"
            class="emr-favorite-btn favorited absolute top-3 right-3 z-[10]"
            data-recipe-id="${escapeHtml(recipe.id)}"
            data-recipe-title="${escapeHtml(recipe.titulo)}"
            aria-pressed="true"
            aria-label="Remover ${escapeHtml(recipe.titulo)} das favoritas"
          >
            <svg width="25" height="25" viewBox="0 0 512 512" fill="none" aria-hidden="true">
              <path class="mr-heart-path" d="M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z" />
            </svg>
          </button>
        </div>
        <div class="py-4 flex-1 flex flex-col">
          <a href="/categoria/${escapeHtml(recipe.categoriaSlug)}" class="inline-block w-fit text-xs leading-4 font-bold uppercase tracking-[0.025em] text-[#B03D1F] hover:text-[#963218] transition-colors no-underline">
            ${escapeHtml(recipe.categoriaLabel)}
          </a>
          <h3 class="recipe-title mt-1.5 mb-0 text-[18px] leading-7 font-bold text-[#666666] group-hover:text-[#1F1F1F] transition-colors line-clamp-3">
            <a href="${escapeHtml(recipe.url)}" class="text-inherit no-underline">${escapeHtml(recipe.titulo)}</a>
          </h3>
          ${meta ? `<div class="recipe-meta mt-auto pt-3 border-t border-[#F3F4F6] text-xs leading-4 font-bold text-[#6B7280]">${escapeHtml(meta)}</div>` : ''}
        </div>
      </article>
    `;
  };

  const renderFavorites = async () => {
    const favIds = getFavoriteIds();
    const allRecipes = await loadSearchRecipes();
    const favRecipes = favIds
      .map((id) => allRecipes.find((r) => r.id === id))
      .filter((r): r is SearchRecipeItem => Boolean(r));

    skeletonWrap?.classList.add('hidden');

    if (favRecipes.length === 0) {
      gridWrap?.classList.add('hidden');
      emptyWrap?.classList.remove('hidden');
      clearAllBtn?.classList.add('hidden');
      if (subtitle) subtitle.textContent = 'Nenhuma receita salva no momento.';
      return;
    }

    emptyWrap?.classList.add('hidden');
    clearAllBtn?.classList.remove('hidden');
    if (subtitle) {
      subtitle.textContent = `${favRecipes.length} ${favRecipes.length === 1 ? 'receita salva' : 'receitas salvas'} no seu navegador.`;
    }
    if (gridWrap) {
      gridWrap.innerHTML = favRecipes.map(renderCard).join('');
      gridWrap.classList.remove('hidden');
      syncFavoriteUI();
    }
  };

  clearAllBtn?.addEventListener('click', () => {
    window.localStorage.setItem('mr_favorites_v1', '[]');
    syncFavoriteUI();
    void renderFavorites();
    showToast({ type: 'info', message: 'Todas as favoritas foram removidas.' });
  });

  document.addEventListener('mr:favorites-changed', () => {
    void renderFavorites();
  });

  void renderFavorites();
</script>
