---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getAllRecipes, splitRecipeSections, type NormalizedRecipe } from '../../lib/recipes';

export const getStaticPaths = (async () => {
  const allRecipes = await getAllRecipes();

  return allRecipes.map((recipe) => {
    const sameCategory = allRecipes.filter(
      (r) => r.id !== recipe.id && r.categoria.slug === recipe.categoria.slug
    );
    const others = allRecipes.filter(
      (r) => r.id !== recipe.id && r.categoria.slug !== recipe.categoria.slug
    );
    const related = [...sameCategory, ...others].slice(0, 3);

    return {
      params: { id: recipe.id },
      props: { recipe, related },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  recipe: NormalizedRecipe;
  related: NormalizedRecipe[];
}

const { recipe, related } = Astro.props;
const { Content } = await render(recipe.entry);

const renderedHtml = recipe.entry.rendered?.html ?? '';
const { introHtml, sections } = splitRecipeSections(renderedHtml);

const ingredientsSection = sections.find((s) => s.kind === 'ingredients');
const stepsSection = sections.find((s) => s.kind === 'steps');
const extraSections = sections.filter((s) => s !== ingredientsSection && s !== stepsSection);

const ingredientsList =
  ingredientsSection && ingredientsSection.items.length > 0
    ? ingredientsSection.items
    : (recipe.entry.data.ingredientes ?? []);

const stepsList =
  stepsSection && stepsSection.items.length > 0
    ? stepsSection.items
    : (recipe.entry.data.preparo ?? []);

const hasStructuredSections = ingredientsList.length > 0 || stepsList.length > 0;
---

<BaseLayout
  title={`${recipe.titulo} | Minha Receita`}
  description={recipe.resumo}
>
  <!-- Hero Interno da Receita (DESIGN SYSTEM §7.6.B) -->
  <section class="mr-recipe-print-hero relative min-h-[340px] lg:min-h-[384px] bg-[#1F1F1F] overflow-hidden mr-surface-dark flex items-end pb-14 pt-6">
    <img
      src={recipe.imagem}
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-55 mr-no-print"
    />
    <div
      class="absolute inset-0 mr-no-print"
      style="background: var(--mr-overlay-hero);"
      aria-hidden="true"
    ></div>

    <div class="relative z-[10] max-w-[1024px] w-full mx-auto px-4 sm:px-6">
      <div class="mr-no-print">
        <Breadcrumb
          tone="dark"
          items={[
            { label: 'Início', href: '/' },
            { label: recipe.categoria.label, href: `/categoria/${recipe.categoria.slug}` },
            { label: recipe.titulo },
          ]}
        />
      </div>

      <div class="mt-2 flex flex-wrap items-center gap-2.5">
        <a
          href={`/categoria/${recipe.categoria.slug}`}
          class="inline-flex items-center px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wide text-white no-underline shadow-sm hover:opacity-90 transition-opacity"
          style={`background-color: var(${recipe.categoria.cssVarAA})`}
        >
          {recipe.categoria.label}
        </a>
        {recipe.dificuldade && (
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-white/15 border border-white/25 text-xs font-bold text-white">
            Dificuldade: {recipe.dificuldade}
          </span>
        )}
      </div>

      <h1 class="text-[24px] leading-[30px] sm:text-[30px] sm:leading-[36px] font-bold text-white mt-3 mb-2 max-w-[780px]">
        {recipe.titulo}
      </h1>

      <p class="text-sm sm:text-base leading-6 text-white/90 max-w-[680px] mb-5">
        {recipe.resumo}
      </p>

      {(recipe.porcoes || recipe.tempoPreparo) && (
        <div class="flex flex-wrap items-center gap-5 text-white">
          {recipe.porcoes && (
            <div class="rendimento inline-flex items-center gap-2.5">
              <span class="w-10 h-10 rounded-full bg-[#C73E00] inline-flex items-center justify-center shrink-0" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
              <div>
                <span class="block text-[11px] uppercase tracking-wide text-white/80 font-semibold">Rendimento</span>
                <span class="block text-sm font-bold">{recipe.porcoes}</span>
              </div>
            </div>
          )}

          {recipe.tempoPreparo && (
            <div class="tempo-preparo inline-flex items-center gap-2.5">
              <span class="w-10 h-10 rounded-full bg-[#C73E00] inline-flex items-center justify-center shrink-0" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
                  <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
              <div>
                <span class="block text-[11px] uppercase tracking-wide text-white/80 font-semibold">Preparo</span>
                <span class="block text-sm font-bold">{recipe.tempoPreparo}</span>
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- Foto Principal em Destaque -->
  <div class="max-w-[928px] mx-auto px-4 sm:px-6 -mt-8 relative z-[20]">
    <div class="relative rounded-2xl overflow-hidden shadow-lg aspect-[16/9] bg-[#F3F4F6]">
      <img
        src={recipe.imagem}
        alt={recipe.imagemAlt}
        class="w-full h-full object-cover"
      />
      <div class="mr-no-print">
        <FavoriteButton
          recipe={recipe}
          className="absolute top-4 right-4 z-[10]"
        />
      </div>
    </div>
  </div>

  <!-- Corpo da Receita (2 colunas assimétricas, max-w-[928px]) -->
  <article
    class="max-w-[928px] mx-auto px-4 sm:px-6 my-8 sm:my-10"
    data-recipe-detail
    data-recipe-id={recipe.id}
  >
    {introHtml && (
      <div class="mr-prose mb-8 pb-6 border-b border-[#E5E7EB]" set:html={introHtml} />
    )}

    {hasStructuredSections ? (
      <div class="grid gap-10">
        {ingredientsList.length > 0 && (
          <section aria-labelledby="heading-ingredientes" class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-6 lg:gap-12">
            <div>
              <h2
                id="heading-ingredientes"
                class="text-[24px] leading-[30px] sm:text-[28px] sm:leading-[32px] font-medium text-[#1F1F1F] m-0"
              >
                {ingredientsSection?.title || 'Ingredientes'}
              </h2>
              <p class="text-xs font-semibold text-[#6B7280] mt-2 mb-3" id="mr-ingredients-progress">
                0 de {ingredientsList.length} separados
              </p>
              <button
                id="mr-reset-checklist"
                type="button"
                class="mr-no-print hidden text-xs font-bold text-[#B03D1F] hover:underline bg-transparent border-0 p-0 cursor-pointer"
              >
                Limpar marcações
              </button>
            </div>

            <ul class="list-none m-0 p-0 grid gap-3">
              {ingredientsList.map((itemHtml, idx) => (
                <li>
                  <label class="flex items-start gap-3 cursor-pointer group py-0.5">
                    <input
                      type="checkbox"
                      class="mr-ingredient-checkbox"
                      data-ingredient-index={idx}
                    />
                    <span
                      class="mr-ingredient-text text-base leading-6 text-[#666666] group-hover:text-[#1F1F1F] transition-colors"
                      set:html={itemHtml}
                    />
                  </label>
                </li>
              ))}
            </ul>
          </section>
        )}

        {ingredientsList.length > 0 && stepsList.length > 0 && (
          <hr class="border-0 border-t border-[#E5E7EB] m-0" />
        )}

        {stepsList.length > 0 && (
          <section aria-labelledby="heading-preparo" class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-6 lg:gap-12">
            <div>
              <h3
                id="heading-preparo"
                class="text-[22px] leading-[28px] sm:text-[26px] sm:leading-[32px] font-medium text-[#1F1F1F] m-0"
              >
                {stepsSection?.title || 'Modo de preparo'}
              </h3>
              <p class="text-xs text-[#6B7280] mt-2 mb-0 mr-no-print">
                Clique nos passos conforme avança na cozinha.
              </p>
            </div>

            <ol class="list-none m-0 p-0 grid gap-5">
              {stepsList.map((stepHtml, idx) => (
                <li
                  class="mr-step-item flex items-start gap-4 cursor-pointer group"
                  data-step-index={idx}
                >
                  <button
                    type="button"
                    aria-pressed="false"
                    aria-label={`Marcar passo ${idx + 1} como concluído`}
                    class="mr-step-number shrink-0 w-8 h-8 rounded-full bg-[#FAF5F3] border border-[#FAA96B] text-[#B03D1F] text-sm font-bold inline-flex items-center justify-center transition-colors cursor-pointer group-hover:bg-[#B03D1F] group-hover:text-white group-hover:border-[#B03D1F]"
                  >
                    {idx + 1}
                  </button>
                  <div
                    class="mr-step-text text-base leading-6 text-[#666666] pt-1 transition-colors"
                    set:html={stepHtml}
                  />
                </li>
              ))}
            </ol>
          </section>
        )}

        {extraSections.map((sec) => (
          <>
            <hr class="border-0 border-t border-[#E5E7EB] m-0" />
            <section class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-6 lg:gap-12">
              <h2 class="text-[22px] leading-[28px] font-medium text-[#1F1F1F] m-0">
                {sec.title}
              </h2>
              <div class="mr-prose" set:html={sec.html} />
            </section>
          </>
        ))}
      </div>
    ) : (
      <div class="mr-prose">
        <Content />
      </div>
    )}

    {recipe.tags.length > 0 && (
      <div class="mt-8 pt-6 border-t border-[#F3F4F6] flex flex-wrap items-center gap-2 mr-no-print">
        <span class="text-xs font-bold uppercase tracking-wide text-[#6B7280] mr-1">
          Tags:
        </span>
        {recipe.tags.map((tag) => (
          <a
            href={`/busca?q=${encodeURIComponent(tag)}`}
            class="px-3 py-1 rounded-full bg-[#FAF5F3] border border-[#FAA96B]/50 text-xs font-semibold text-[#503C3C] hover:border-[#B03D1F] hover:text-[#B03D1F] no-underline transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </article>

  <!-- Compartilhamento, Avaliação 5 Estrelas e Arquivo Fonte -->
  <section
    class="mr-no-print max-w-[928px] mx-auto px-4 sm:px-6 py-7 border-t border-b border-[#E5E7EB] flex flex-col md:flex-row md:items-center justify-between gap-6"
    aria-label="Compartilhar e avaliar receita"
  >
    <div class="share-section flex flex-wrap items-center gap-3">
      <span class="text-sm font-bold text-[#6B7280]">Compartilhe:</span>

      <a
        id="mr-share-whatsapp"
        href={`https://wa.me/?text=${encodeURIComponent(`Confira esta receita: ${recipe.titulo}`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="social-button w-8 h-8 rounded-full bg-black text-white hover:bg-gray-800 inline-flex items-center justify-center transition-colors"
        aria-label="Compartilhar no WhatsApp"
        title="Compartilhar no WhatsApp"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .16 5.33.16 11.9c0 2.1.55 4.15 1.59 5.95L0 24l6.33-1.66a11.88 11.88 0 0 0 5.73 1.46h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.42zm-8.46 18.31a9.87 9.87 0 0 1-5.04-1.38l-.36-.21-3.75.98 1-3.66-.23-.37a9.87 9.87 0 0 1-1.52-5.25c0-5.46 4.44-9.9 9.9-9.9 2.64 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.9 7c0 5.46-4.44 9.89-9.9 9.89zm5.43-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35z" />
        </svg>
      </a>

      <button
        id="mr-copy-link-btn"
        type="button"
        class="inline-flex items-center gap-1.5 h-9 px-3.5 rounded-full border border-[#E5E7EB] bg-white hover:bg-[#FAF5F3] text-xs font-bold text-[#374151] transition-colors cursor-pointer"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span>Copiar link</span>
      </button>

      <button
        id="mr-print-btn"
        type="button"
        class="inline-flex items-center gap-1.5 h-9 px-3.5 rounded-full border border-[#E5E7EB] bg-white hover:bg-[#FAF5F3] text-xs font-bold text-[#374151] transition-colors cursor-pointer"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" stroke="currentColor" stroke-width="2" />
          <rect x="6" y="14" width="12" height="8" stroke="currentColor" stroke-width="2" />
        </svg>
        <span>Imprimir</span>
      </button>
    </div>

    <!-- Avaliação 5 estrelas local -->
    <div class="kk-star-ratings flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-1" role="radiogroup" aria-label="Avaliar esta receita">
        {[1, 2, 3, 4, 5].map((star) => (
          <button
            type="button"
            data-star-value={star}
            aria-label={`Avaliar com ${star} ${star === 1 ? 'estrela' : 'estrelas'}`}
            class="mr-star-btn p-0.5 bg-transparent border-0 cursor-pointer text-[#D1D5DB] hover:scale-110 transition-transform"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          </button>
        ))}
      </div>
      <span id="mr-rating-legend" class="text-sm sm:text-base font-bold text-[#1F1F1F]">
        Avalie esta receita
      </span>
    </div>
  </section>

  <!-- Info do arquivo .md e link de categoria -->
  <div class="mr-no-print max-w-[928px] mx-auto px-4 sm:px-6 mt-5 flex flex-wrap items-center justify-between gap-3 text-sm">
    <a
      href={`/categoria/${recipe.categoria.slug}`}
      class="font-bold text-[#B03D1F] hover:text-[#963218] no-underline hover:underline"
    >
      Ver mais: {recipe.categoria.label} →
    </a>
    <span class="text-xs text-[#6B7280]">
      Arquivo Markdown: <code class="font-mono text-[#1F1F1F] bg-[#FAF5F3] px-2 py-0.5 rounded">receitas/{recipe.id}.md</code>
    </span>
  </div>

  <!-- Receitas Relacionadas -->
  {related.length > 0 && (
    <section
      class="mr-no-print max-w-[928px] mx-auto px-4 sm:px-6 mt-12"
      aria-labelledby="titulo-relacionadas"
    >
      <h4 id="titulo-relacionadas" class="mr-section-title mb-6">
        Receitas relacionadas
      </h4>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {related.map((item) => (
          <RecipeCard recipe={item} />
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/receitas" class="mr-btn-pill">
          Todas as receitas
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { showToast } from '../../scripts/toast';

  const article = document.querySelector<HTMLElement>('[data-recipe-detail]');
  const recipeId = article?.dataset.recipeId ?? 'default';

  // 1. Checklist interativo de ingredientes
  const checkboxes = Array.from(
    document.querySelectorAll<HTMLInputElement>('.mr-ingredient-checkbox[data-ingredient-index]')
  );
  const progressEl = document.getElementById('mr-ingredients-progress');
  const resetBtn = document.getElementById('mr-reset-checklist');
  const checklistKey = `mr_checklist_${recipeId}`;

  const loadCheckedIndices = (): Set<number> => {
    try {
      const raw = window.localStorage.getItem(checklistKey);
      const arr = raw ? JSON.parse(raw) : [];
      return new Set(Array.isArray(arr) ? arr : []);
    } catch {
      return new Set();
    }
  };

  const syncChecklistUI = () => {
    let checkedCount = 0;
    checkboxes.forEach((cb) => {
      const textSpan = cb.closest('label')?.querySelector('.mr-ingredient-text');
      textSpan?.classList.toggle('is-checked', cb.checked);
      if (cb.checked) checkedCount += 1;
    });
    if (progressEl) {
      progressEl.textContent = `${checkedCount} de ${checkboxes.length} separados`;
    }
    resetBtn?.classList.toggle('hidden', checkedCount === 0);
  };

  if (checkboxes.length > 0) {
    const saved = loadCheckedIndices();
    checkboxes.forEach((cb) => {
      const idx = Number(cb.dataset.ingredientIndex);
      cb.checked = saved.has(idx);
      cb.addEventListener('change', () => {
        const next = checkboxes
          .filter((item) => item.checked)
          .map((item) => Number(item.dataset.ingredientIndex));
        try {
          window.localStorage.setItem(checklistKey, JSON.stringify(next));
        } catch {
          // ignore
        }
        syncChecklistUI();
      });
    });
    syncChecklistUI();

    resetBtn?.addEventListener('click', () => {
      checkboxes.forEach((cb) => {
        cb.checked = false;
      });
      try {
        window.localStorage.removeItem(checklistKey);
      } catch {
        // ignore
      }
      syncChecklistUI();
      showToast({ type: 'info', message: 'Marcações de ingredientes limpas.' });
    });
  }

  // 2. Passos interativos do Modo de Preparo
  const stepItems = Array.from(document.querySelectorAll<HTMLElement>('.mr-step-item[data-step-index]'));
  const stepsKey = `mr_steps_${recipeId}`;

  const syncStepItem = (li: HTMLElement, done: boolean) => {
    li.classList.toggle('is-done', done);
    const btn = li.querySelector<HTMLButtonElement>('.mr-step-number');
    btn?.setAttribute('aria-pressed', String(done));
  };

  if (stepItems.length > 0) {
    let doneSteps = new Set<number>();
    try {
      const raw = window.localStorage.getItem(stepsKey);
      const arr = raw ? JSON.parse(raw) : [];
      if (Array.isArray(arr)) doneSteps = new Set(arr);
    } catch {
      // ignore
    }

    stepItems.forEach((li) => {
      const idx = Number(li.dataset.stepIndex);
      syncStepItem(li, doneSteps.has(idx));

      li.addEventListener('click', () => {
        if (doneSteps.has(idx)) {
          doneSteps.delete(idx);
          syncStepItem(li, false);
        } else {
          doneSteps.add(idx);
          syncStepItem(li, true);
        }
        try {
          window.localStorage.setItem(stepsKey, JSON.stringify(Array.from(doneSteps)));
        } catch {
          // ignore
        }
      });
    });
  }

  // 3. Copiar link, WhatsApp URL & Imprimir
  const waLink = document.getElementById('mr-share-whatsapp') as HTMLAnchorElement | null;
  if (waLink) {
    const title = document.querySelector('h1')?.textContent?.trim() ?? 'Receita';
    waLink.href = `https://wa.me/?text=${encodeURIComponent(`${title} — ${window.location.href}`)}`;
  }

  document.getElementById('mr-copy-link-btn')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      showToast({ type: 'success', message: 'Link copiado para a área de transferência!' });
    } catch {
      showToast({ type: 'error', message: 'Não foi possível copiar o link automaticamente.' });
    }
  });

  document.getElementById('mr-print-btn')?.addEventListener('click', () => {
    window.print();
  });

  // 4. Avaliação 5 estrelas local
  const starBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.mr-star-btn[data-star-value]'));
  const ratingLegend = document.getElementById('mr-rating-legend');
  const ratingsKey = 'mr_ratings_v1';

  const getRatings = (): Record<string, number> => {
    try {
      const raw = window.localStorage.getItem(ratingsKey);
      return raw ? (JSON.parse(raw) as Record<string, number>) : {};
    } catch {
      return {};
    }
  };

  const renderStars = (score: number) => {
    starBtns.forEach((btn) => {
      const val = Number(btn.dataset.starValue);
      btn.classList.toggle('text-[#FF8F1C]', val <= score);
      btn.classList.toggle('text-[#D1D5DB]', val > score);
    });
    if (ratingLegend) {
      ratingLegend.textContent = score > 0 ? `${score}/5 - (Sua avaliação)` : 'Avalie esta receita';
    }
  };

  const currentScore = getRatings()[recipeId] ?? 0;
  renderStars(currentScore);

  starBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = Number(btn.dataset.starValue);
      const map = getRatings();
      map[recipeId] = val;
      try {
        window.localStorage.setItem(ratingsKey, JSON.stringify(map));
      } catch {
        // ignore
      }
      renderStars(val);
      showToast({ type: 'success', message: `Avaliação de ${val}/5 registrada!` });
    });
  });
</script>
